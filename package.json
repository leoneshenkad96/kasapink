{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "pnpm --filter @workspace/erp-rumahan-emak run build && node ./scripts/build-vercel-api.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:erp:postgres": "node --test ./scripts/erp-postgres.test.mjs",
    "test:security": "node ./scripts/security-api-test.mjs",
    "test:e2e": "playwright test",
    "check:palette": "node ./scripts/check-palette.mjs",
    "test:auth": "node --test ./scripts/auth-session.test.mjs",
    "test:auth:postgres": "node --test ./scripts/auth-postgres.test.mjs",
    "backup:erp": "node ./scripts/backup-erp.mjs",
    "backup:install": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-daily-backup.ps1",
    "backup:check": "node ./scripts/check-backup.mjs",
    "restore:erp": "node ./scripts/restore-erp.mjs",
    "check:migrations": "node ./scripts/check-migrations.mjs",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-local.ps1",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-local.ps1"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.0",
    "helmet": "^8.3.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "esbuild": "0.28.2",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
