{
  "version": 2,
  "buildCommand": "cd artifacts/erp-rumahan-emak && npm run build",
  "outputDirectory": "artifacts/erp-rumahan-emak/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/artifacts/erp-rumahan-emak/dist/public/$1"
    }
  ]
}